# ─────────────────────────────────────────────────────────────────────────────
# Módulo Sinergia · Modelo Predictivo — variables de entorno
# Copiar a .env y ajustar.  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_USER=modelo
DB_PASS=CAMBIA_ESTA_CLAVE
DB_NAME=modelo_predictivo
# DB_HOST/DB_PORT los fija docker-compose (postgres:5432). Para BBDD externa,
# descomenta y ajusta:
# DB_HOST=mi-postgres
# DB_PORT=5432
# PGSSLMODE=require

# ── Job del modelo ────────────────────────────────────────────────────────────
PRED_DIAS=7           # horizonte de predicción (días hacia delante)
HORA_EJECUCION=03:00  # hora del recálculo diario
FACTOR_K=0.563        # factor de calibración sensor->personas

# ── Frontal ───────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080

# ── Territorio (deben coincidir con config/master-data.seed.csv) ─────────────
# Perfil ACTIVO: demo Burgos (coherente con los datos de ejemplo incluidos).
APP_AUTONOMOUS_COMMUNITY=ES-CYL
APP_PROVINCE=ES-BU
APP_MUNICIPALITY=ES-BU-BU

# Perfil Las Rozas de Madrid (descomentar y usar el master-data.seed.csv del
# destino con estos mismos códigos):
# APP_AUTONOMOUS_COMMUNITY=ES-MD
# APP_PROVINCE=ES-M
# APP_MUNICIPALITY=ES-MD-ROZ
